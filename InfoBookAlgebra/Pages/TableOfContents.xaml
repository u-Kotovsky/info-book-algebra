<Page x:Class="InfoBookAlgebra.Pages.TableOfContents"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InfoBookAlgebra.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Содержание">

    <Grid>
        <DataGrid x:Name="contentsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="contentsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тема" Binding="{Binding Path=Name}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
